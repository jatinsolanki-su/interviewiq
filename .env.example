# ============================================================================
# INTERVIEWIQ — LOCAL ENVIRONMENT VARIABLES (.env.example)
# Copy this file to '.env' in your project root and update values.
# ============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Secret for Session Authentication & HttpOnly Cookies
JWT_SECRET="interviewiq_super_secret_jwt_random_key_change_me_2026"

# Google Gemini API Key (FREE from Google AI Studio)
# Get yours free at: https://aistudio.google.com/
# Gemini 3.8 Flash powers resume extraction, voice evaluation, and evidence tracking.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Local PostgreSQL Database Credentials (Community Edition)
# Step 1: Install PostgreSQL from https://www.postgresql.org/download/
# Step 2: Create a database named 'interviewiq'
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=interviewiq

# Optional complete connection string (alternative to discrete PG* variables above)
# DATABASE_URL="postgresql://postgres:your_postgres_password@localhost:5432/interviewiq"

# Local Application URL (Used for API references)
APP_URL="http://localhost:3000"
